# ── Asaas ──────────────────────────────────────────────────────
ASAAS_API_KEY=            # $aas_xxx (sandbox) ou $aas_live_xxx (produção)
ASAAS_WEBHOOK_TOKEN=      # Token configurado no painel Asaas → Integrações → Webhooks
ASAAS_ENV=sandbox         # 'sandbox' ou 'production'

# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── JWT (validation tokens do app) ──────────────────────────────
JWT_SECRET=troque-por-uma-string-secreta-longa-e-aleatoria-aqui

# ── Resend (email transacional) ─────────────────────────────────
RESEND_API_KEY=re_...

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://iris-website-eta.vercel.app
