# Copie para .env.local e preencha localmente.
# Nunca versione valores reais.

# ── CORE: obrigatório no boot ───────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=       # formato: https://projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # formato: JWT/service_role

# Opcional/legado: atualmente não é lida pelo código
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # formato: JWT/anon

# Licença
JWT_SECRET=                     # formato: string longa e aleatória

# Administração
ADMIN_EMAIL=                    # formato: admin@example.com
ADMIN_PASSWORD=                 # formato: senha forte
ADMIN_JWT_SECRET=               # formato: string longa e aleatória

# E-mail
RESEND_API_KEY=                 # formato: re_...

# Site
NEXT_PUBLIC_SITE_URL=           # formato: https://example.com

# Cakto
CAKTO_WEBHOOK_SECRET=           # formato: UUID/chave secreta do webhook
NEXT_PUBLIC_CAKTO_LIFETIME_ID=  # formato: ID da oferta vitalícia

# Upsell pós-compra (opcional)
# A oferta só aparece quando os quatro campos abaixo estão configurados.
# A rota deve validar order_id no servidor e garantir idempotência antes de cobrar.
UPSELL_ACTION_PATH=             # formato: /api/upsell
UPSELL_TITLE=                   # formato: nome curto da oferta
UPSELL_DESCRIPTION=             # formato: benefício em uma frase
UPSELL_PRICE=                   # formato: R$ 00,00
UPSELL_ACTION_LABEL=            # formato: Adicionar ao pedido

# ── Provedores opcionais ────────────────────────────────────────
# A ausência destas variáveis não derruba o site. As respectivas
# rotas retornam HTTP 503.

# Asaas
ASAAS_API_KEY=                  # formato: $aas_...
ASAAS_WEBHOOK_TOKEN=            # formato: token configurado no webhook
ASAAS_ENV=                      # sandbox | production

# Stripe
STRIPE_SECRET_KEY=              # formato: sk_...
STRIPE_WEBHOOK_SECRET=          # formato: whsec_...
