# ── AbacatePay ─────────────────────────────────────────────────
ABACATEPAY_API_KEY=                 # Bearer token do dashboard AbacatePay
ABACATEPAY_ANNUAL_PRODUCT_ID=        # Produto com cycle ANNUALLY
ABACATEPAY_LIFETIME_PRODUCT_ID=      # Produto avulso
ABACATEPAY_WEBHOOK_SECRET=           # Secret usado na URL do webhook
ABACATEPAY_WEBHOOK_PUBLIC_KEY=       # Opcional; usa a chave pública padrão da documentação se vazio

# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── JWT (validation tokens do app) ──────────────────────────────
JWT_SECRET=troque-por-uma-string-secreta-longa-e-aleatoria-aqui

# ── Resend (email transacional) ─────────────────────────────────
RESEND_API_KEY=re_...

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://iris-website-eta.vercel.app
